{
    "name": "inheritdevs/api-calculadora-uvt",
    "description": "API que convierte montos a UVT y de UVT a pesos con la tabla oficial de cada ano y calcula las retenciones de renta e IVA.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "php",
        "uvt",
        "retenciones",
        "colombia",
        "api-rest",
        "finanzas"
    ],
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "InheritDevs\\Uvt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InheritDevs\\Uvt\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=never --fail-on-empty-test-suite",
        "lint": "find src public tests -name '*.php' -print0 | xargs -0 -r -n1 php -l"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
